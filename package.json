{
  "name": "@local/dsh-redteam-console",
  "version": "2.0.0",
  "private": true,
  "description": "Adversarial review console: an independent red-team subagent and an independent scoring subagent, four evidence screenshots per round, and a 95/100 stop gate, rendered as a native Harness Web panel.",
  "type": "module",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "rubrics/**/*.md",
    "README.md",
    "CONTRACT.md",
    "docs/**/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
